# LLM Provider (Groq - free)
LLM_API_KEY=gsk_...

# Pydantic settings use PDFSIGN_ prefix
PDFSIGN_LLM_BASE_URL=https://api.groq.com/openai/v1
PDFSIGN_LLM_MODEL=llama-3.3-70b-versatile
PDFSIGN_CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]
PDFSIGN_API_SECRET_KEY=
PDFSIGN_STORAGE_ROOT=/data/tmp
PDFSIGN_DB_PATH=/data/applications.db
