# Copy this file to backend/.env and fill in LLM_API_KEY.
#
# FREE options (no payment required):
#   Gemini — https://aistudio.google.com (Google AI Studio)  ← default below
#   Groq   — https://console.groq.com
#
# Without a key the app still runs, using a keyword-based fallback.

LLM_API_KEY=

# --- Provider preset: Google Gemini (free, default) ---
PDFSIGN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PDFSIGN_LLM_MODEL=gemini-2.0-flash

# --- Alternative: Groq (free) ---
# PDFSIGN_LLM_BASE_URL=https://api.groq.com/openai/v1
# PDFSIGN_LLM_MODEL=llama-3.3-70b-versatile

PDFSIGN_REPORT_LANGUAGE=English

# Optional: protect the n8n webhook with a bearer token.
PDFSIGN_API_SECRET_KEY=
