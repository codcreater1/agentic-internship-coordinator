{
  "name": "Internship Report Review",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "q": "subject:\"Internship Report\" has:attachment"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [-420, 0]
    },
    {
      "parameters": {
        "operation": "get",
        "messageId": "={{ $json.id }}",
        "simple": false,
        "options": {
          "downloadAttachments": true
        }
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Get Message With Attachments",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COORDINATOR_API_URL }}/reports/from-n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.COORDINATOR_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "intern_email",
              "value": "={{ $json.from.value[0].address }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "files",
              "inputDataFieldName": "=attachment_0"
            },
            {
              "parameterType": "formBinaryData",
              "name": "files",
              "inputDataFieldName": "=attachment_1"
            },
            {
              "parameterType": "formBinaryData",
              "name": "files",
              "inputDataFieldName": "=attachment_2"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Review Package",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [40, 0],
      "notes": "All three attachments go up under the same field name. The backend decides which document is which by reading them, so attachment order does not matter. neverError is set because a package held for clarification is a normal outcome returned as 201 — and because a genuine 5xx should still reach the reply node rather than leaving the student with no response."
    },
    {
      "parameters": {
        "sendTo": "={{ $json.intern_email }}",
        "subject": "={{ $json.email_subject }}",
        "emailType": "text",
        "message": "={{ $json.email_body }}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Reply To Student",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [300, -110],
      "notes": "One node for every outcome. The backend composes the subject and body from the findings — drafted by the LLM when available, from templates when not — so there is no branching here, and no second place where the wording of a request can drift out of sync with the reason for it."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "b2000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "b2000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Ready For A Coordinator?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [300, 120]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.COORDINATOR_EMAIL }}",
        "subject": "=Internship completion to review: {{ $json.student_name }} ({{ $json.status }})",
        "emailType": "text",
        "message": "={{ $json.student_name }} ({{ $json.student_id }}) — {{ $json.company }}\n\nStatus         : {{ $json.status }}\nWorking days   : {{ $json.counted_working_days }}\nEmployer score : {{ $json.evaluation_score }}/100\nReport length  : {{ $json.report_word_count }} words\nSimilarity     : {{ $json.max_similarity }}\n\n{{ $json.report }}\n\nOpen points:\n{{ $json.findings.filter(f => f.severity === 'warning').map(f => '- ' + f.code + ': ' + f.message).join('\\n') || '- none' }}\n\nAdvisory review:\n{{ $json.advisory && $json.advisory.available ? $json.advisory.summary : 'not available (the decision does not depend on it)' }}\n\nReview and sign in the dashboard:\n{{ $env.COORDINATOR_DASHBOARD_URL }}\n\nThis package is NOT signed. Nothing is issued to the student until a coordinator signs it.",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Notify Coordinator",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [540, 120],
      "notes": "The workflow stops here. Signing is a deliberate action in the dashboard against POST /reports/by-id/{id}/sign; a node that called it automatically would remove the only human from the process and leave the university issuing completion certificates on the strength of a regex over a PDF."
    }
  ],
  "pinData": {},
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Get Message With Attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Message With Attachments": {
      "main": [
        [
          {
            "node": "Review Package",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Review Package": {
      "main": [
        [
          {
            "node": "Reply To Student",
            "type": "main",
            "index": 0
          },
          {
            "node": "Ready For A Coordinator?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready For A Coordinator?": {
      "main": [
        [
          {
            "node": "Notify Coordinator",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "agentic-internship-coordinator"
  },
  "id": "internship-report-review",
  "tags": []
}
